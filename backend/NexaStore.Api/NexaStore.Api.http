@NexaStore.Api_HostAddress = http://localhost:5175

### AI provider status
GET {{NexaStore.Api_HostAddress}}/api/assistant/status
Accept: application/json

### Stream a tool-grounded local Ollama response
POST {{NexaStore.Api_HostAddress}}/api/assistant/chat/stream
Content-Type: application/json
Accept: text/event-stream

{
  "responseStyle": "balanced",
  "messages": [
    {
      "role": "user",
      "content": "Find AI-ready products with at least 64 GB RAM and 16 GB VRAM."
    }
  ]
}

GET {{NexaStore.Api_HostAddress}}/api/products
Accept: application/json

###

GET {{NexaStore.Api_HostAddress}}/api/products/search?ramMin=64&vramMin=16&aiReady=true
Accept: application/json

###

GET {{NexaStore.Api_HostAddress}}/api/categories
Accept: application/json

###

GET {{NexaStore.Api_HostAddress}}/health

